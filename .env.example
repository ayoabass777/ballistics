# Database
DB_NAME=ballistics
DB_USER=ballistics_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
# Hostname used by dbt inside Docker Compose.
DBT_DB_HOST=postgres

# Football API (API-Sports direct)
API_KEY=your_api_key_here
API_URL=https://v3.football.api-sports.io/

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=ca-central-1
S3_BUCKET=ballistics-raw

# Airflow
AIRFLOW__WEBSERVER__SECRET_KEY=change-this-to-a-random-string
AIRFLOW__WEBSERVER__DEFAULT_USER_PASSWORD=admin
# Host repo path used by Airflow DockerOperator bind mounts.
# Set this to the output of `pwd` from the repository root.
PROJECT_ROOT=replace_with_repo_root_path

# Season tracker (earliest season to process)
MIN_SEASON_TRACKER=2020
