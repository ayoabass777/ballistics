{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ballistics-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-02-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_USE_MOCK_DATA": "false",
    "UPSTASH_REDIS_REST_URL": "https://suited-cattle-97117.upstash.io",
    "BACKEND_API_BASE_URL": "https://api.ballistics.football",
    "NEXT_PUBLIC_API_BASE_URL": "https://api.ballistics.football"
  }
}
