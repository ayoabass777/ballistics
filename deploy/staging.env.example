# Copy to deploy/.env.staging on the server (gitignored, chmod 600) and fill
# in. Every value is new for staging: none is shared with local or v1.
# Master copies belong in a password manager.

# Paths on the server
PROJECT_ROOT=/srv/ballistics
ACCOUNT_REPO=/srv/football_stats_project
RELEASE=latest

# Postgres: owner (pipeline, dbt, migrations) and service roles
DB_USER=ballistics
DB_PASSWORD=
AIRFLOW_DB_PASSWORD=
ACCOUNT_DB_PASSWORD=
RESEARCH_DB_PASSWORD=

# Airflow
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=

# API-Football (shared quota with v1 until v1 is retired)
API_FOOTBALL_KEY=

# AWS: IAM user limited to the staging buckets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ca-central-1
S3_BUCKET=
ASSETS_BUCKET=
FORECAST_ARCHIVE_BUCKET=
SAVED_ARCHIVE_BUCKET=
CREST_BASE_URL=

# Clerk production instance (ballistics.football)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# Beta invitations (new values; codes issued elsewhere will not verify)
BETA_INVITE_API_KEY=
BETA_INVITE_PEPPER=

# Alerts (use an app password)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
