# Ballistics v2 behind Cloudflare (proxied DNS, SSL mode "Full (strict)").
# TLS uses a Cloudflare origin certificate in deploy/certs/ (not in git):
#   origin.pem, origin.key
# Only the frontend is public. The two APIs stay on the internal network;
# the frontend's server-side proxies call them.

{
	email {$ACME_EMAIL:admin@ballistics.football}
	servers {
		# Real client IPs from Cloudflare's CF-Connecting-IP header.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

staging.ballistics.football, beta.ballistics.football {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Team and league logos are served by the account API; the frontend builds
	# these URLs from BACKEND_API_BASE_URL (lib/logo-asset-url.ts), so they
	# must be reachable from the browser. Nothing else of that API is public.
	handle /assets/logos/* {
		reverse_proxy account-api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Anything else (bare IP, unknown host): refuse.
:80, :443 {
	abort
}
